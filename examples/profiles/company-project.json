{
  "schemaVersion": 1,
  "projectId": "project_example_company_repo",
  "name": "example-company-repository",
  "packageManager": "pnpm",
  "checks": {
    "build": { "program": "pnpm", "args": ["build"] },
    "test": { "program": "pnpm", "args": ["test"] },
    "typecheck": { "program": "pnpm", "args": ["typecheck"] }
  },
  "glossaryPath": "GLOSSARY.md",
  "policy": {
    "allowShell": false,
    "allowNetworkTelemetry": false,
    "allowedProviders": ["local"],
    "maxOutputBytes": 262144
  }
}
