{
  "description": "Thin, local-only Vertical Pair Router host integration",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}

